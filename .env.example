# Copier ce fichier en « .env » et adapter les valeurs. Ne jamais mettre .env sur GitHub.
# Lancer ensuite avec : node --env-file=.env src/server.js
PORT=3000
NODE_ENV=development
# Nombre maximal de messages par visiteur toutes les 15 minutes
LIMITE_MESSAGES=5

# À ajouter en semaine 3 (notification par courriel, voir src/services/notification.js) :
# SMTP_HOTE=
# SMTP_PORT=
# SMTP_UTILISATEUR=
# SMTP_MOT_DE_PASSE=
# COURRIEL_DESTINATAIRE=
