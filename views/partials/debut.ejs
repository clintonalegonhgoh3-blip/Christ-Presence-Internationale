<%# Début commun à toutes les pages : <head>, lien d'évitement, en-tête et menu. Responsable : FRONTEND 1 %>
<!doctype html>
<html lang="fr" class="sans-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= titrePage %></title>
  <meta name="description" content="<%= descriptionPage %>">
  <meta name="theme-color" content="#20234a">
  <link rel="icon" href="<%= ressource('img/favicon.svg') %>" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&family=Literata:opsz,wght@7..72,500;7..72,600&display=swap">
  <link rel="stylesheet" href="<%= ressource('css/base.css') %>">
  <link rel="stylesheet" href="<%= ressource('css/mise-en-page.css') %>">
  <link rel="stylesheet" href="<%= ressource('css/composants.css') %>">
  <link rel="stylesheet" href="<%= ressource('css/pages.css') %>">
  <script src="<%= ressource('js/menu.js') %>"></script>
</head>
<body>
  <a class="lien-evitement" href="#contenu">Aller au contenu</a>

  <header class="entete">
    <div class="conteneur entete__barre">
      <a class="marque" href="<%= lien('accueil') %>">
        <svg class="marque__logo" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
          <circle cx="16" cy="16" r="15" class="marque__halo"/>
          <rect x="14" y="6" width="4" height="20" rx="1.2" class="marque__croix"/>
          <rect x="9" y="11.5" width="14" height="4" rx="1.2" class="marque__croix"/>
        </svg>
        <span class="marque__nom"><%= site.nom %></span>
      </a>

      <button class="menu-bouton" type="button" aria-expanded="false" aria-controls="menu-principal">
        <span class="menu-bouton__icone" aria-hidden="true"><span></span></span>
        <span class="menu-bouton__texte">Menu</span>
      </button>

      <nav id="menu-principal" class="menu" aria-label="Menu principal">
        <ul class="menu__liste">
          <% menu.forEach(function (p) { %>
            <li><a class="menu__lien" href="<%= lien(p.id) %>"<% if (p.id === pageActive) { %> aria-current="page"<% } %>><%= p.titreMenu %></a></li>
          <% }) %>
        </ul>
        <a class="bouton bouton--principal menu__action" href="<%= lien('contact') %>#visite">Nous rendre visite</a>
      </nav>
    </div>
  </header>

  <main id="contenu" tabindex="-1">
